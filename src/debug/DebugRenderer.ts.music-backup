interface BoosterParticle {
  x: number;
  y: number;
  vx: number;
  vy: number;
  life: number;
  maxLife: number;
  radius: number;
}

export class DebugRenderer {
  private boosterParticles: BoosterParticle[] = [];
  private boosterSpawnTimer = 0;
  private lastBoosterVfxTime = 0;


  private background = new Image();
  private ground = new Image();
  private astronaut = new Image();
  private scoreImage = new Image();
  private coinImage = new Image();
  private adminImage = new Image();
  private titleImage = new Image();
  private howToPlayImage = new Image();
  private shopImage = new Image();
  private blankBarImage = new Image();
  private bestScorePanelImage = new Image();
  private startButtonImage = new Image();
  private gameOverImage = new Image();
  private restartButtonImage = new Image();
  private pauseButtonImage = new Image();
  private playPauseImage = new Image();
  private pauseRestartImage = new Image();
  private astronautFrames: HTMLImageElement[] = [];
  private obstacleSprites: Partial<Record<ObstacleType, HTMLImageElement[]>> = {};
  private laserEmitterImage = new Image();
  private powerupButtonImages: Record<ShopItem, { normal: HTMLImageElement; selected: HTMLImageElement }>;
  private bestScore = 0;

  constructor(private game: Game, private telemetry: Telemetry) {
    try {
      this.bestScore = Number(localStorage.getItem("starfall-best-score")) || 0;
    } catch {
      this.bestScore = 0;
    }
    this.background.src = "/assets/background/alien_background.png";
    this.ground.src = "/assets/environment/alien_ground.png";
    this.astronaut.src = "/assets/player/astronaut.png";
    this.scoreImage.src = "/assets/ui/score.png";
    this.coinImage.src = "/assets/effects/coin.png";
    this.adminImage.src = "/assets/ui/admin.png";
    this.titleImage.src = "/assets/ui/tittle.png";
    this.howToPlayImage.src = "/assets/ui/how_to_play.png";
    this.shopImage.src = "/assets/ui/shop.png";
    this.blankBarImage.src = "/assets/ui/blanck_bar.png";
    this.bestScorePanelImage.src = "/assets/ui/bestscore_panel.png";
    this.startButtonImage.src = "/assets/ui/start_game_button.png";
    this.gameOverImage.src = "/assets/ui/gameover.png";
    this.restartButtonImage.src = "/assets/ui/restart_button.png";
    this.pauseButtonImage.src = "/assets/ui/Puase_button.png";
    this.playPauseImage.src = "/assets/ui/play_pause.png";
    this.pauseRestartImage.src = "/assets/ui/restart.png";
    this.laserEmitterImage.src = "/assets/obstacles/obstaculos_png/obstacles_09_emisor_laser.png";
    const powerupButton = (normal: string, selected: string) => ({
      normal: this.loadObstacleImage(`/assets/effects/botones_powerups/${normal}`),
      selected: this.loadObstacleImage(`/assets/effects/botones_powerups/${selected}`),
    });
    this.powerupButtonImages = {
      revive: powerupButton("boton_1_revive_normal.png", "boton_1_revive_seleccionado.png"),
      shield: powerupButton("boton_2_shield_normal.png", "boton_2_shield_seleccionado.png"),
      doubleCoins: powerupButton("boton_3_coins_normal.png", "boton_3_coins_seleccionado.png"),
      booster: powerupButton("boton_4_booster_normal.png", "boton_4_booster_seleccionado.png"),
    };
    for (let i = 1; i <= 19; i++) {
      const img = new Image();
      img.src = `/assets/player/astronautas_png/recortados/astronauta_${String(i).padStart(2, "0")}.png`;
      this.astronautFrames.push(img);
    }

    const obstacleAsset = (name: string) => `/assets/obstacles/obstaculos_png/${name}`;
    const sprites = (names: string[]) => names.map((name) => this.loadObstacleImage(obstacleAsset(name)));
    this.obstacleSprites[ObstacleType.GATE] = sprites([
      "obstacles_03_compuerta_laser.png",
    ]);
    this.obstacleSprites[ObstacleType.BLOCK_TOP] = sprites([
      "obstacles_01_tuberias.png",
      "obstacles_04_bobina_tesla.png",
      "obstacles_07_tuberias_grupo.png",
      "obstacles_11_generador_electrico.png",
    ]);
    this.obstacleSprites[ObstacleType.BLOCK_BOTTOM] = sprites([
      "obstacles_01_tuberias.png",
      "obstacles_02_maquina.png",
      "obstacles_04_bobina_tesla.png",
      "obstacles_07_tuberias_grupo.png",
      "obstacles_11_generador_electrico.png",
    ]);
    this.obstacleSprites[ObstacleType.FLOATING] = sprites([
      "obstacles_02_maquina.png",
      "obstacles_05_cristal.png",
      "obstacles_06_dron.png",
      "obstacles_08_cilindro.png",
      "obstacles_10_cristal_grande.png",
      "obstacles_11_generador_electrico.png",
    ]);
    this.obstacleSprites[ObstacleType.MOVING] = sprites([
      "obstacles_04_bobina_tesla.png",
      "obstacles_06_dron.png",
    ]);
  }

  private loadObstacleImage(src: string): HTMLImageElement {
    const img = new Image();
    img.src = src;
    return img;
  }
  

render(ctx: CanvasRenderingContext2D, stats: FrameStats): void {
  ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

  this.drawBackground(ctx);

  const playerView = this.game.playerTheme === "player";

  if (!playerView && this.game.debug.grid) this.drawGrid(ctx);
  if (!playerView) this.drawCorridor(ctx);
  this.drawGround(ctx);
  this.drawObstacles(ctx);
  this.drawCoins(ctx);
this.game.coinPickupEffect.draw(ctx);
  if (!playerView && this.game.debug.encounters && this.game.spawner.searchMode)
    this.drawEncounters(ctx);

  this.drawPlayer(ctx);

  if (playerView) {
    if (this.game.state === GameState.READY) {
      this.drawPlayerStartScreen(ctx);
    } else {
      this.drawPlayerScore(ctx);
      if (this.game.state === GameState.DEAD) this.drawPlayerGameOver(ctx);
      else {
        this.drawAdminButton(ctx);
        if (this.game.state === GameState.RUNNING) this.drawPlayerPowerups(ctx);
        if (this.game.state === GameState.PAUSED) this.drawPlayerPauseOverlay(ctx);
        else this.drawPlayerPauseButton(ctx);
      }
    }
    return;
  }

  if (this.game.debug.trajectory) this.drawTrajectories(ctx);
  if (this.game.debug.vectors) this.drawVectors(ctx);
  if (this.game.debug.telemetry) this.drawTelemetry(ctx);
  if (this.game.debug.overlay) this.drawHud(ctx, stats);

  this.drawStateOverlays(ctx);
}

private drawBackground(ctx: CanvasRenderingContext2D): void {
  const img = this.background;

  if (!img.complete || !img.naturalWidth) return;

  const scale = Math.max(
    CANVAS_WIDTH / img.naturalWidth,
    CANVAS_HEIGHT / img.naturalHeight
  );

  const width = img.naturalWidth * scale;
  const height = img.naturalHeight * scale;

  const offset = (this.game.camera.x * 0.15) % width;

  ctx.drawImage(img, -offset, 0, width, height);
  ctx.drawImage(img, width - offset, 0, width, height);
}

private drawGround(ctx: CanvasRenderingContext2D): void {
  const img = this.ground;

  if (!img.complete || !img.naturalWidth) return;

  const width = img.naturalWidth;
  const height = img.naturalHeight;
  const floorY = this.game.world.floorY();

  const offset = this.game.camera.x % width;

  ctx.drawImage(
    img,
    -offset,
    floorY - height / 2,
    width,
    height
  );

  ctx.drawImage(
    img,
    width - offset,
    floorY - height / 2,
    width,
    height
  );
}

  /** anchor vertical grid lines to world x so camera movement stays visible */
  private drawGrid(ctx: CanvasRenderingContext2D): void {
    const camX = this.game.camera.x;
    ctx.lineWidth = 1;

    for (let gx = Math.floor(camX / 50) * 50; gx < camX + CANVAS_WIDTH + 50; gx += 50) {
      const sx = Math.round(gx - camX) + 0.5;
      const major = gx % 250 === 0;
      ctx.strokeStyle = major ? COLORS.gridMajor : COLORS.gridMinor;
      ctx.beginPath();
      ctx.moveTo(sx, 0);
      ctx.lineTo(sx, CANVAS_HEIGHT);
      ctx.stroke();
      if (major && this.game.debug.overlay) {
        this.text(ctx, `${gx}px`, sx + 3, CANVAS_HEIGHT - 6, COLORS.gridLabel);
      }
    }

    for (let gy = 0; gy < CANVAS_HEIGHT; gy += 50) {
      ctx.strokeStyle = COLORS.gridMinor;
      ctx.beginPath();
      ctx.moveTo(0, gy + 0.5);
      ctx.lineTo(CANVAS_WIDTH, gy + 0.5);
      ctx.stroke();
    }
  }

private drawCorridor(ctx: CanvasRenderingContext2D): void {
  const w = this.game.world;

  if (this.game.debug.colliders) {
    ctx.strokeStyle = COLORS.collider;
    ctx.lineWidth = 2;

    ctx.strokeRect(0, -2, CANVAS_WIDTH, w.ceilingY() + 2);

    ctx.strokeRect(
      0,
      w.floorY(),
      CANVAS_WIDTH,
      CANVAS_HEIGHT - w.floorY() + 2
    );

    this.text(ctx, "CEILING collider", 8, w.ceilingY() - 6, COLORS.collider);
    this.text(ctx, "FLOOR collider", 8, w.floorY() + 14, COLORS.collider);
  }
}

  private drawObstacles(ctx: CanvasRenderingContext2D): void {
    const g = this.game;
    const { camera, cfg } = g;
    const dbg = g.debug;
    const showDebug = g.playerTheme === "admin";
    const showColliders = showDebug && dbg.colliders;
    const showOverlay = showDebug && dbg.overlay;

    for (const obs of g.obstacles) {
      const sx = obs.worldX - camera.x;
      if (sx > CANVAS_WIDTH + 40 || sx + obs.width < -60) continue;

      const rects = obs.getRects(camera.x, g.time);
      const fill = !obs.possible
        ? COLORS.obstacleBad
        : obs.type === ObstacleType.MOVING
          ? COLORS.obstacleMoving
          : COLORS.obstacle;

      let drewSprite = false;
      if (Object.values(this.obstacleSprites).flat().some((img) => img.complete && img.naturalWidth > 0)) {
        drewSprite = this.drawObstacleSprite(ctx, obs, rects);
      }

      if (!drewSprite) {
        if (showColliders && obs.type === ObstacleType.GATE && obs.gapTop !== null && obs.gapBottom !== null) {
          ctx.fillStyle = COLORS.safeGap;
          ctx.fillRect(sx, obs.gapTop, obs.width, obs.gapBottom - obs.gapTop);
          ctx.setLineDash([4, 4]);
          ctx.strokeStyle = COLORS.collider;
          ctx.lineWidth = 1;
          ctx.strokeRect(sx, obs.gapTop, obs.width, obs.gapBottom - obs.gapTop);
          ctx.setLineDash([]);
        }

        for (const r of rects) {
          ctx.globalAlpha = obs.possible ? 0.92 : 0.72;
          ctx.fillStyle = fill;
          ctx.fillRect(r.x, r.y, r.w, r.h);
          ctx.globalAlpha = 1;
          if (showDebug && (dbg.colliders || !dbg.overlay)) {
            ctx.strokeStyle = obs.possible ? COLORS.collider : COLORS.danger;
            ctx.lineWidth = 1.5;
            ctx.strokeRect(r.x + 0.5, r.y + 0.5, r.w - 1, r.h - 1);
          }
        }
      } else if (showColliders) {
        for (const r of rects) {
          ctx.strokeStyle = obs.possible ? COLORS.collider : COLORS.danger;
          ctx.lineWidth = 1.5;
          ctx.strokeRect(r.x + 0.5, r.y + 0.5, r.w - 1, r.h - 1);
        }
      }

      if (!showOverlay) continue;

      const dist = obs.distanceToPlayer(camera.x, cfg.playerScreenX, cfg.playerWidth);
      const ttp = obs.timeToPlayer(camera.x, cfg.playerScreenX, cfg.playerWidth, g.worldSpeed);
      const labelX = sx;
      let labelY = Math.max(30, rects.length ? rects[0].y - 44 : 30);
      if (rects.length && rects[0].y < 60) labelY = rects[0].y + rects[0].h + 14;

      this.text(ctx, `#${obs.id} ${obs.type}`, labelX, labelY, COLORS.text);
      this.text(
        ctx,
        `D ${dist.toFixed(0)}px  T ${isFinite(ttp) ? ttp.toFixed(2) : "inf"}s`,
        labelX,
        labelY + 12,
        COLORS.textDim,
      );
      let extra = `react@spawn ${obs.spawnReactionTime.toFixed(2)}s`;
      if (obs.gapTop !== null && obs.gapBottom !== null) {
        extra = `gap ${(obs.gapBottom - obs.gapTop).toFixed(0)}px  ` + extra;
      }
      this.text(ctx, extra, labelX, labelY + 24, COLORS.textDim);
      let lineY = labelY + 36;
      if (obs.encounter) {
        this.text(ctx, `E${obs.encounter.index} ${obs.encounter.phase} · ${obs.encounter.candidateId}`, labelX, lineY, COLORS.encounter);
        lineY += 12;
      }
      if (obs.recoveryAfter > 0) {
        this.text(ctx, `RECOVERY after: +${obs.recoveryAfter.toFixed(2)}s`, labelX, lineY, COLORS.vel);
        lineY += 12;
      }
      if (!obs.possible) {
        this.text(ctx, `REJECTED: ${obs.rejectReason}`, labelX, lineY, COLORS.danger);
      }
    }
  }

  /**
   * Searched encounters: start/end brackets, the fixed entry states the search
   * tested, the feasibility witness (dashed) and the three agent profiles'
   * recorded paths from the middle entry state. Traces are world-space
   * positions the headless simulation predicted, drawn in screen space.
   */

  private previousPowerupStates: Record<ShopItem, boolean> = {
    revive: false,
    shield: false,
    doubleCoins: false,
    booster: false,
  };

  private previousPowerupCounts: Record<ShopItem, number> = {
    revive: 0,
    shield: 0,
    doubleCoins: 0,
    booster: 0,
  };

  private powerupNotice = "";
  private powerupNoticeColor = "#5EEBFF";
  private powerupNoticeUntil = 0;
  private powerupTrackingInitialized = false;

  private drawEncounters(ctx: CanvasRenderingContext2D): void {
    const g = this.game;
    const { camera, cfg } = g;
    for (const rec of g.spawner.scheduler.committed) {
      const sx0 = rec.startX - camera.x;
      const sx1 = rec.endX - camera.x;
      if (sx1 < -60 || sx0 > CANVAS_WIDTH + 60) continue;

      ctx.save();
      ctx.setLineDash([3, 5]);
      ctx.lineWidth = 1;
      ctx.strokeStyle = COLORS.encounter;
      ctx.beginPath();
      ctx.moveTo(Math.round(sx0) + 0.5, 0);
      ctx.lineTo(Math.round(sx0) + 0.5, CANVAS_HEIGHT);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();

      const fit = rec.fitness ? rec.fitness.fitness.toFixed(2) : "—";
      const c = rec.metrics?.completion;
      const completion = c ? `S${c.strong.toFixed(1)} I${c.intermediate.toFixed(1)} N${c.novice.toFixed(1)}` : "";
      // labels sit just above the floor, clear of the HUD box and the obstacle labels near the ceiling
      const floorY = g.world.floorY();
      this.text(ctx, `E${rec.index} ${rec.phase} d${rec.target.difficulty.toFixed(2)} · ${rec.candidateId} fit ${fit} ${completion}${rec.fallback ? " · FALLBACK" : ""}`,
        sx0 + 4, floorY - 30, COLORS.encounter);
      this.text(ctx, rec.phrase, sx0 + 4, floorY - 18, COLORS.textDim);

      // entry states sit where the headless simulation placed the player at its first step
      const entryX = rec.startCameraX + cfg.playerScreenX - camera.x;
      if (entryX > -40 && entryX < CANVAS_WIDTH + 40) {
        ctx.strokeStyle = COLORS.entry;
        ctx.lineWidth = 1;
        rec.entries.forEach((e, i) => {
          ctx.strokeRect(entryX + 0.5, e.y + 0.5, cfg.playerWidth, cfg.playerHeight);
          if (i === 0) this.text(ctx, `${rec.entries.length} entry states`, entryX + cfg.playerWidth + 4, e.y + 10, COLORS.entry);
        });
      }

      const toScreen = (frames: Array<{ cameraX: number; y: number }>) =>
        frames.map((f) => ({ x: f.cameraX + cfg.playerScreenX + cfg.playerWidth / 2 - camera.x, y: f.y + cfg.playerHeight / 2 }));
      if (rec.validation?.witness) this.polyline(ctx, toScreen(rec.validation.witness), COLORS.witness, [6, 4]);
      if (rec.rollouts && rec.entries.length) {
        const middle = rec.entries[Math.floor(rec.entries.length / 2)].label;
        const styles: Record<string, string> = { strong: COLORS.strongPath, intermediate: COLORS.intermediatePath, novice: COLORS.novicePath };
        for (const r of rec.rollouts) {
          if (r.entry !== middle || !r.trace) continue;
          const pts = toScreen(r.trace);
          this.polyline(ctx, pts, styles[r.profile], []);
          const last = pts[pts.length - 1];
          if (r.hitId !== null && last) {
            ctx.strokeStyle = styles[r.profile];
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(last.x - 5, last.y - 5); ctx.lineTo(last.x + 5, last.y + 5);
            ctx.moveTo(last.x + 5, last.y - 5); ctx.lineTo(last.x - 5, last.y + 5);
            ctx.stroke();
          }
        }
        if (sx0 > -200 && sx0 < CANVAS_WIDTH) {
          this.text(ctx, "witness ··· · strong — · intermediate — · novice —", sx0 + 4, floorY - 6, COLORS.textDim);
        }
      }
    }
  }

private updatePowerupNotifications(): void {
  const items: ShopItem[] = [
    "revive",
    "shield",
    "doubleCoins",
    "booster",
  ];

  const names: Record<ShopItem, string> = {
    revive: "REVIVE",
    shield: "SHIELD",
    doubleCoins: "DOUBLE COINS",
    booster: "BOOSTER",
  };

  const colors: Record<ShopItem, string> = {
    revive: "#8EFFCB",
    shield: "#5EEBFF",
    doubleCoins: "#FFD45E",
    booster: "#C678FF",
  };

  for (const item of items) {
    const active = this.game.isPowerupActive(item);
    const count = this.game.shopInventory[item];

    if (!this.powerupTrackingInitialized) {
      this.previousPowerupStates[item] = active;
      this.previousPowerupCounts[item] = count;
      continue;
    }

    const wasActive = this.previousPowerupStates[item];
    const previousCount = this.previousPowerupCounts[item];

    if (!wasActive && active) {
      this.powerupNotice = `${names[item]} ACTIVATED`;
      this.powerupNoticeColor = colors[item];
      this.powerupNoticeUntil = this.game.time + 1.8;
    }

    if (wasActive && !active) {
      if (item === "doubleCoins" || item === "booster") {
        this.powerupNotice = `${names[item]} EXPIRED!`;
        this.powerupNoticeColor = "#FF8294";
        this.powerupNoticeUntil = this.game.time + 1.8;
      } else if (count < previousCount) {
        this.powerupNotice = `${names[item]} USED!`;
        this.powerupNoticeColor = colors[item];
        this.powerupNoticeUntil = this.game.time + 1.8;
      } else {
        this.powerupNotice = `${names[item]} DEACTIVATED`;
        this.powerupNoticeColor = colors[item];
        this.powerupNoticeUntil = this.game.time + 1.8;
      }
    }

    this.previousPowerupStates[item] = active;
    this.previousPowerupCounts[item] = count;
  }

  this.powerupTrackingInitialized = true;
}

private drawPowerupAura(ctx: CanvasRenderingContext2D): void {
  const g = this.game;
  const r = g.player.rect();

  const effects = [
    { item: "shield" as ShopItem, color: "#5EEBFF" },
    { item: "doubleCoins" as ShopItem, color: "#FFD45E" },
    { item: "booster" as ShopItem, color: "#C678FF" },
  ];

  const active = effects.filter(
    (effect) => g.isPowerupActive(effect.item)
  );

  if (active.length === 0) return;

  ctx.save();
  active.forEach((effect, index) => {
    const remaining = g.getPowerupRemaining(effect.item);
    const warning = remaining <= 1;
    ctx.globalAlpha = warning ? 0.9 : 0.55;
    ctx.strokeStyle = effect.color;
    ctx.lineWidth = warning ? 2.5 : 1.5;
    const pad = 7 + index * 4;
    const left = r.x - pad;
    const right = r.x + r.w + pad;
    const top = r.y - pad;
    const bottom = r.y + r.h + pad;
    const corner = 7 + index * 2;
    ctx.beginPath();
    ctx.moveTo(left, top + corner);
    ctx.lineTo(left, top);
    ctx.lineTo(left + corner, top);
    ctx.moveTo(right - corner, top);
    ctx.lineTo(right, top);
    ctx.lineTo(right, top + corner);
    ctx.moveTo(right, bottom - corner);
    ctx.lineTo(right, bottom);
    ctx.lineTo(right - corner, bottom);
    ctx.moveTo(left + corner, bottom);
    ctx.lineTo(left, bottom);
    ctx.lineTo(left, bottom - corner);
    ctx.stroke();
  });

  ctx.restore();
}

private drawPowerupNotification(ctx: CanvasRenderingContext2D): void {
  if (
    !this.powerupNotice ||
    this.game.time > this.powerupNoticeUntil
  ) {
    return;
  }

  const remaining = this.powerupNoticeUntil - this.game.time;
  const alpha = Math.min(1, remaining / 0.4);

  const width = 300;
  const height = 42;
  const x = (CANVAS_WIDTH - width) / 2;
  const y = 88;

  ctx.save();

  ctx.globalAlpha = alpha;

  this.drawAngularPanel(
    ctx,
    x,
    y,
    width,
    height,
    8,
    "rgba(10, 12, 30, 0.92)",
    this.powerupNoticeColor
  );

  ctx.font = "bold 15px Menlo, Consolas, monospace";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillStyle = this.powerupNoticeColor;
  ctx.shadowColor = this.powerupNoticeColor;
  ctx.shadowBlur = 12;

  ctx.fillText(
    this.powerupNotice,
    CANVAS_WIDTH / 2,
    y + height / 2
  );

  ctx.restore();
}

private drawPowerupTimers(ctx: CanvasRenderingContext2D): void {
  const items: Array<{
    item: ShopItem;
    label: string;
    color: string;
    duration: number;
  }> = [
    {
      item: "doubleCoins",
      label: "DOUBLE COINS",
      color: "#FFD45E",
      duration: 10,
    },
    {
      item: "booster",
      label: "BOOSTER",
      color: "#C678FF",
      duration: 6,
    },
  ];

  const x = CANVAS_WIDTH - 190;
  let y = 100;

  for (const effect of items) {
    if (!this.game.isPowerupActive(effect.item)) continue;

    const remaining = this.game.getPowerupRemaining(effect.item);
    const progress = Math.max(
      0,
      Math.min(1, remaining / effect.duration)
    );

    const barWidth = 160;
    const barHeight = 7;

    ctx.save();

    ctx.font = "bold 10px Menlo, Consolas, monospace";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    ctx.fillStyle = effect.color;
    ctx.shadowBlur = 0;

    ctx.fillText(effect.label, x, y);

    ctx.textAlign = "right";
    ctx.fillText(`${remaining.toFixed(1)}s`, x + barWidth, y);

    ctx.shadowBlur = 0;
    ctx.fillStyle = "rgba(20, 22, 38, 0.9)";
    ctx.fillRect(x, y + 10, barWidth, barHeight);

    ctx.fillStyle = effect.color;
    ctx.shadowColor = effect.color;
    ctx.shadowBlur = 0;
    ctx.fillRect(x, y + 10, barWidth * progress, barHeight);

    ctx.restore();

    y += 32;
  }
}



private spawnBoosterParticle(x: number, y: number): void {
  this.boosterParticles.push({
    x,
    y,
    vx: -140 - Math.random() * 180,
    vy: (Math.random() - 0.5) * 90,
    life: 0.35 + Math.random() * 0.3,
    maxLife: 0.65,
    radius: 2 + Math.random() * 4,
  });
}

private drawBoosterTrail(
  ctx: CanvasRenderingContext2D,
  x: number,
  y: number,
  dt: number,
  active: boolean
): void {
  this.boosterSpawnTimer -= dt;

  if (active && this.boosterSpawnTimer <= 0) {
    this.spawnBoosterParticle(x, y);
    this.boosterSpawnTimer = 0.025;
  }

  for (let i = this.boosterParticles.length - 1; i >= 0; i--) {
    const p = this.boosterParticles[i];

    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.life -= dt;

    if (p.life <= 0) {
      this.boosterParticles.splice(i, 1);
      continue;
    }

    const alpha = Math.max(0, p.life / p.maxLife);

    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.globalCompositeOperation = "lighter";

    ctx.shadowBlur = 18;
    ctx.shadowColor = "#A855F7";
    ctx.fillStyle = "#A855F7";

    ctx.beginPath();
    ctx.arc(p.x, p.y, p.radius * alpha, 0, Math.PI * 2);
    ctx.fill();

    ctx.shadowColor = "#22D3EE";
    ctx.shadowBlur = 10;
    ctx.fillStyle = "#22D3EE";

    ctx.beginPath();
    ctx.arc(p.x, p.y, p.radius * alpha * 0.4, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
  }
}

private drawPlayer(ctx: CanvasRenderingContext2D): void {
  const g = this.game;
  const p = g.player;
  const r = p.rect();

const frame = this.getPlayerFrame(g.time, p.thrusting, p.state);

const vfxDt = Math.max(0, g.time - this.lastBoosterVfxTime);
this.lastBoosterVfxTime = g.time;

this.drawBoosterTrail(
  ctx,
  r.x - 3,
  r.y + r.h * 0.65,
  vfxDt,
  g.isPowerupActive("booster") && g.state === GameState.RUNNING
);




if (
  g.playerTheme === "player" &&
  g.state === GameState.RUNNING
) {
  this.drawPowerupAura(ctx);
}

ctx.save();
  if (g.playerTheme === "admin") {
    ctx.filter = "hue-rotate(170deg) saturate(1.35) brightness(1.08)";
  }
  if (frame?.complete && frame.naturalWidth > 0) {
    ctx.drawImage(frame, r.x, r.y, r.w, r.h);
  } else if (this.astronaut.complete && this.astronaut.naturalWidth > 0) {
    ctx.drawImage(this.astronaut, r.x, r.y, r.w, r.h);
  } else {
    ctx.fillStyle = COLORS.player;
    ctx.fillRect(r.x, r.y, r.w, r.h);
  }
  ctx.restore();

  if (g.playerTheme === "admin") {
    ctx.strokeStyle = "rgba(90, 220, 255, 0.8)";
    ctx.lineWidth = 2;
    ctx.strokeRect(r.x + 3, r.y + 3, r.w - 6, r.h - 6);
  }

  if (p.thrusting && g.state === GameState.RUNNING) {
    const cx = r.x + r.w / 2;

    ctx.fillStyle = COLORS.flame;
    ctx.beginPath();
    ctx.moveTo(cx - 7, r.y + r.h);
    ctx.lineTo(cx + 7, r.y + r.h);
    ctx.lineTo(cx, r.y + r.h + 14);
    ctx.closePath();
    ctx.fill();
  }

  if (g.playerTheme === "admin" && g.debug.colliders) {
    ctx.strokeStyle = COLORS.collider;
    ctx.lineWidth = 2;
    ctx.strokeRect(r.x, r.y, r.w, r.h);
    ctx.fillStyle = COLORS.collider;
    ctx.fillRect(p.centerX() - 1, p.centerY() - 1, 2, 2);
  }
}

  private drawTrajectories(ctx: CanvasRenderingContext2D): void {
    const g = this.game;

    const hold = predictScreenPath(g, true);
    const release = predictScreenPath(g, false);
    this.polyline(ctx, hold, COLORS.trajHold, [6, 4]);
    this.polyline(ctx, release, COLORS.trajRelease, [2, 4]);

    if (hold.length) this.text(ctx, "HOLD path", hold[hold.length - 1].x - 70, hold[hold.length - 1].y - 8, COLORS.trajHold);
    if (release.length) this.text(ctx, "RELEASE path", release[release.length - 1].x - 70, release[release.length - 1].y + 14, COLORS.trajRelease);

    // mark the first hit for the current held or released branch
    const hit = predictedHit(g);
    if (hit) {
      ctx.strokeStyle = COLORS.danger;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(hit.x - 6, hit.y - 6);
      ctx.lineTo(hit.x + 6, hit.y + 6);
      ctx.moveTo(hit.x + 6, hit.y - 6);
      ctx.lineTo(hit.x - 6, hit.y + 6);
      ctx.stroke();
      this.text(ctx, `predicted hit #${hit.obstacleId} (current input)`, hit.x + 10, hit.y - 10, COLORS.danger);
    }
  }

  /**
   * Physics vectors from the player center.
   * velocity uses world speed for x even though screen x stays fixed
   */
  private drawVectors(ctx: CanvasRenderingContext2D): void {
    const g = this.game;
    const p = g.player;
    const ox = p.centerX();
    const oy = p.centerY();

    const V_SCALE = 0.15; // line pixels per px/s
    const A_SCALE = 0.055; // line pixels per px/s^2

    this.arrow(ctx, ox, oy, ox + g.worldSpeed * V_SCALE, oy + p.vy * V_SCALE, COLORS.vel, `v=(${g.worldSpeed.toFixed(0)},${p.vy.toFixed(0)})`);
    this.arrow(ctx, ox, oy, ox, oy + g.cfg.gravity * A_SCALE, COLORS.gravity, `g=${g.cfg.gravity.toFixed(0)}`);
    if (p.thrusting) {
      this.arrow(ctx, ox, oy, ox, oy + g.cfg.thrustAcceleration * A_SCALE, COLORS.thrust, `T=${g.cfg.thrustAcceleration.toFixed(0)}`);
    }
    this.arrow(ctx, ox, oy, ox, oy + p.ay * A_SCALE, COLORS.net, `a=${p.ay.toFixed(0)}`);
  }

  private drawTelemetry(ctx: CanvasRenderingContext2D): void {
    const T = this.telemetry;
    const rows: Array<{ label: string; unit: string; pick: (s: { y: number; vy: number; ay: number; speed: number }) => number; color: string }> = [
      { label: "y", unit: "px", pick: (s) => s.y, color: "#e8e8ec" },
      { label: "vy", unit: "px/s", pick: (s) => s.vy, color: COLORS.vel },
      { label: "ay", unit: "px/s^2", pick: (s) => s.ay, color: COLORS.thrust },
      { label: "speed", unit: "px/s", pick: (s) => s.speed, color: COLORS.trajRelease },
    ];

    const stripH = rows.length * 30 + 8;
    const top = CANVAS_HEIGHT - stripH;
    ctx.fillStyle = "rgba(8, 10, 13, 0.72)";
    ctx.fillRect(0, top, CANVAS_WIDTH, stripH);

    rows.forEach((row, i) => {
      const gy = top + 4 + i * 30;
      const gh = 22;
      const gw = CANVAS_WIDTH - 220;
      const gx = 150;

      const { min, max } = T.minMax(row.pick);
      const samples = T.samples;
      const latest = samples.length ? row.pick(samples[samples.length - 1]) : 0;

      this.text(ctx, `${row.label} [${row.unit}]`, 8, gy + 12, COLORS.text);
      this.text(ctx, `${latest.toFixed(1)}`, gx + gw + 8, gy + 12, row.color);
      this.text(ctx, `${min.toFixed(0)}..${max.toFixed(0)}`, gx - 62, gy + 12, COLORS.textDim);

      ctx.strokeStyle = "#2b303c";
      ctx.strokeRect(gx, gy, gw, gh);
      if (samples.length < 2) return;

      ctx.strokeStyle = row.color;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (let j = 0; j < samples.length; j++) {
        const v = row.pick(samples[j]);
        const px = gx + (j / (T.capacity - 1)) * gw;
        const py = gy + gh - ((v - min) / (max - min)) * gh;
        if (j === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();
    });
  }

  private drawPlayerScore(ctx: CanvasRenderingContext2D): void {
    const score = Math.max(0, Math.floor(this.game.camera.x / 10)) + this.game.coinsCollected * 100;
    if (score > this.bestScore) {
      this.bestScore = score;
      try {
        localStorage.setItem("starfall-best-score", String(score));
      } catch {
        // Keep the current-session best score when storage is unavailable.
      }
    }
    const w = 190;
    const h = 72;
    const x = CANVAS_WIDTH - w - 18;
    const y = 12;

    if (this.scoreImage.complete && this.scoreImage.naturalWidth) {
      ctx.drawImage(this.scoreImage, x, y, w, h);
    }
    ctx.save();
    ctx.font = "bold 18px Menlo, Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#5ef0ff";
    ctx.shadowColor = "#5ef0ff";
    ctx.shadowBlur = 8;
    ctx.fillText(score.toString(), x + 155, y + 38);
    ctx.restore();

    if (this.coinImage.complete && this.coinImage.naturalWidth) {
      ctx.drawImage(this.coinImage, 274, 18, 30, 30);
    }
    ctx.save();
    ctx.font = "bold 18px Menlo, Consolas, monospace";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#ffe28a";
    ctx.fillText(String(this.game.totalCoins), 310, 34);
    ctx.restore();
  }

  private drawCoins(ctx: CanvasRenderingContext2D): void {
    if (!this.coinImage.complete || !this.coinImage.naturalWidth) return;
    for (const coin of this.game.coinSpawner.coins) {
      if (coin.collected) continue;
      const rect = this.game.coinSpawner.getScreenRect(coin, this.game.camera.x);
      if (rect.x > CANVAS_WIDTH || rect.x + rect.w < 0) continue;
      ctx.drawImage(this.coinImage, rect.x, rect.y, rect.w, rect.h);
    }
  }

  private drawPlayerStartScreen(ctx: CanvasRenderingContext2D): void {
    if (this.game.shopOpen) {
      this.drawPlayerShop(ctx);
      return;
    }

    ctx.fillStyle = "rgba(5, 7, 14, 0.62)";
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    this.drawGeometricFrame(ctx, 12, 12, CANVAS_WIDTH - 24, CANVAS_HEIGHT - 24, 20, "rgba(94, 240, 255, 0.62)");
    this.drawGeometricFrame(ctx, 20, 20, CANVAS_WIDTH - 40, CANVAS_HEIGHT - 40, 15, "rgba(184, 93, 255, 0.26)");

    if (this.titleImage.complete && this.titleImage.naturalWidth) {
      ctx.drawImage(this.titleImage, (CANVAS_WIDTH - 300) / 2, 12, 300, 141);
    }
    if (this.howToPlayImage.complete && this.howToPlayImage.naturalWidth) {
      ctx.drawImage(this.howToPlayImage, 28, 174, 490, 265);
    }
    if (this.bestScorePanelImage.complete && this.bestScorePanelImage.naturalWidth) {
      const panelX = 565;
      ctx.drawImage(this.bestScorePanelImage, panelX, 246, 357, 98);
      ctx.save();
      ctx.font = "bold 26px Menlo, Consolas, monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillStyle = "#f6f0ff";
      ctx.shadowColor = "#5ef0ff";
      ctx.shadowBlur = 8;
      ctx.fillText(String(this.bestScore), panelX + 235, 298);
      ctx.restore();
    }
    if (this.startButtonImage.complete && this.startButtonImage.naturalWidth) {
      const button = PLAYER_START_BUTTON_BOUNDS;
      ctx.drawImage(this.startButtonImage, button.x, button.y, button.w, button.h);
    }
    this.drawShopMenuButton(ctx);
    this.drawCoinBalance(ctx);
  }

  private drawShopMenuButton(ctx: CanvasRenderingContext2D): void {
    const button = PLAYER_SHOP_MENU_BOUNDS;
    if (this.blankBarImage.complete && this.blankBarImage.naturalWidth) {
      const imageHeight = button.w * this.blankBarImage.naturalHeight / this.blankBarImage.naturalWidth;
      ctx.drawImage(this.blankBarImage, button.x, button.y - (imageHeight - button.h) / 2, button.w, imageHeight);
    }
    ctx.save();
    ctx.font = "bold 17px Menlo, Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#f6f0ff";
    ctx.shadowColor = "#5ef0ff";
    ctx.shadowBlur = 7;
    ctx.fillText("POWER-UP SHOP", button.x + button.w / 2, button.y + button.h / 2);
    ctx.shadowBlur = 0;
    ctx.strokeStyle = "rgba(94, 240, 255, 0.9)";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(button.x + 20, button.y + button.h / 2);
    ctx.lineTo(button.x + 28, button.y + button.h / 2 - 7);
    ctx.lineTo(button.x + 36, button.y + button.h / 2);
    ctx.moveTo(button.x + button.w - 20, button.y + button.h / 2);
    ctx.lineTo(button.x + button.w - 28, button.y + button.h / 2 + 7);
    ctx.lineTo(button.x + button.w - 36, button.y + button.h / 2);
    ctx.stroke();
    ctx.restore();
  }

  private drawPlayerShop(ctx: CanvasRenderingContext2D): void {
    ctx.fillStyle = "#10102d";
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    if (this.shopImage.complete && this.shopImage.naturalWidth) {
      const width = this.shopImage.naturalWidth * SHOP_IMAGE_SCALE;
      const height = this.shopImage.naturalHeight * SHOP_IMAGE_SCALE;
      ctx.drawImage(this.shopImage, (CANVAS_WIDTH - width) / 2, (CANVAS_HEIGHT - height) / 2, width, height);
    }

    if (this.coinImage.complete && this.coinImage.naturalWidth) {
      ctx.drawImage(this.coinImage, 811, 53, 32, 32);
    }
    ctx.save();
    ctx.font = "bold 22px Menlo, Consolas, monospace";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#ffe28a";
    ctx.fillText(String(this.game.totalCoins), 854, 70);
    ctx.restore();

    const inventory = this.game.shopInventory;
    const items: ShopItem[] = ["revive", "shield", "doubleCoins", "booster"];
    items.forEach((item, index) => {
      const count = inventory[item];
      if (count < 1) return;
      const bounds = PLAYER_SHOP_OWNED_BOUNDS[index];
      this.drawAngularPanel(
        ctx,
        bounds.x,
        bounds.y,
        bounds.w,
        bounds.h,
        6,
        "rgba(8, 12, 38, 0.94)",
        "#5ef0ff",
      );
      ctx.save();
      ctx.font = "bold 10px Menlo, Consolas, monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillStyle = "#ffffff";
      ctx.fillText(`OWNED x${count}`, bounds.x + bounds.w / 2, bounds.y + bounds.h / 2);
      ctx.restore();
    });

    if (this.game.shopMessage) {
      this.drawAngularPanel(
        ctx,
        342,
        88,
        276,
        34,
        8,
        "rgba(8, 12, 38, 0.94)",
        this.game.shopMessage === "NOT ENOUGH COINS" ? "#ff8396" : "#8effcb",
      );
      ctx.save();
      ctx.font = "bold 15px Menlo, Consolas, monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillStyle = this.game.shopMessage === "NOT ENOUGH COINS" ? "#ff8396" : "#8effcb";
      ctx.fillText(this.game.shopMessage, CANVAS_WIDTH / 2, 105);
      ctx.restore();
    }
  }

  private drawCoinBalance(ctx: CanvasRenderingContext2D): void {
    if (this.coinImage.complete && this.coinImage.naturalWidth) {
      ctx.drawImage(this.coinImage, CANVAS_WIDTH - 72, 18, 30, 30);
    }
    ctx.save();
    ctx.font = "bold 18px Menlo, Consolas, monospace";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#ffe28a";
    ctx.fillText(String(this.game.totalCoins), CANVAS_WIDTH - 38, 34);
    ctx.restore();
  }

  private drawAdminButton(ctx: CanvasRenderingContext2D): void {
    const button = PLAYER_ADMIN_BUTTON_BOUNDS;
    if (this.adminImage.complete && this.adminImage.naturalWidth) {
      ctx.drawImage(this.adminImage, button.x, button.y, button.w, button.h);
    }
  }

  private drawPlayerPauseButton(ctx: CanvasRenderingContext2D): void {
    const button = PLAYER_PAUSE_BUTTON_BOUNDS;
    if (this.pauseButtonImage.complete && this.pauseButtonImage.naturalWidth) {
      ctx.drawImage(this.pauseButtonImage, button.x, button.y, button.w, button.h);
    }
  }


private drawPlayerPowerups(ctx: CanvasRenderingContext2D): void {
  this.updatePowerupNotifications();

  const items: ShopItem[] = [
    "revive",
    "shield",
    "doubleCoins",
    "booster",
  ];

  items.forEach((item, index) => {
    const bounds = PLAYER_POWERUP_BUTTON_BOUNDS[index];
    const images = this.powerupButtonImages[item];
    const available = this.game.shopInventory[item] > 0;
    const active = this.game.isPowerupActive(item);

    const image = active
      ? images.selected
      : images.normal;

    if (image.complete && image.naturalWidth) {
      ctx.save();

      ctx.globalAlpha = available || active ? 1 : 0.38;

      if (active) {
        const colors: Record<ShopItem, string> = {
          revive: "#8EFFCB",
          shield: "#5EEBFF",
          doubleCoins: "#FFD45E",
          booster: "#C678FF",
        };

        ctx.shadowColor = colors[item];
        ctx.shadowBlur = 0;
      }

      ctx.drawImage(
        image,
        bounds.x,
        bounds.y,
        bounds.w,
        bounds.h
      );

      ctx.restore();
    }

    ctx.save();

    ctx.font = "bold 11px Menlo, Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillStyle = available ? "#f6f0ff" : "#a5a9bd";
    ctx.shadowColor = "#0a0b20";
    ctx.shadowBlur = 4;

    ctx.fillText(
      `x${this.game.shopInventory[item]}`,
      bounds.x + bounds.w / 2,
      bounds.y + bounds.h + 8
    );

    ctx.restore();
  });

  this.drawPowerupTimers(ctx);
  this.drawPowerupNotification(ctx);
}


  private drawPlayerPauseOverlay(ctx: CanvasRenderingContext2D): void {
    ctx.fillStyle = "rgba(5, 7, 14, 0.72)";
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    this.drawGeometricFrame(ctx, CANVAS_WIDTH / 2 - 210, 230, 420, 230, 24, "rgba(94, 240, 255, 0.82)");

    ctx.save();
    ctx.font = "bold 34px Menlo, Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#f6f0ff";
    ctx.shadowColor = "#5ef0ff";
    ctx.shadowBlur = 12;
    ctx.fillText("PAUSED", CANVAS_WIDTH / 2, 290);
    ctx.restore();

    const toggle = PLAYER_PAUSE_TOGGLE_BOUNDS;
    if (this.playPauseImage.complete && this.playPauseImage.naturalWidth) {
      ctx.drawImage(this.playPauseImage, toggle.x, toggle.y, toggle.w, toggle.h);
    }
    const restart = PLAYER_PAUSE_RESTART_BOUNDS;
    if (this.pauseRestartImage.complete && this.pauseRestartImage.naturalWidth) {
      ctx.drawImage(this.pauseRestartImage, restart.x, restart.y, restart.w, restart.h);
    }
  }

  private drawPlayerGameOver(ctx: CanvasRenderingContext2D): void {
    ctx.fillStyle = "rgba(5, 7, 14, 0.68)";
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    this.drawGeometricFrame(ctx, CANVAS_WIDTH / 2 - 230, 158, 460, 335, 24, "rgba(184, 93, 255, 0.74)");

    const bannerWidth = 338;
    const bannerHeight = 149;
    const bannerX = (CANVAS_WIDTH - bannerWidth) / 2;
    const bannerY = 192;
    if (this.gameOverImage.complete && this.gameOverImage.naturalWidth) {
      ctx.drawImage(this.gameOverImage, bannerX, bannerY, bannerWidth, bannerHeight);
    }

    if (this.game.shopInventory.revive > 0) {
      const revive = PLAYER_DEAD_REVIVE_BOUNDS;
      const reviveImage = this.powerupButtonImages.revive.selected;
      if (reviveImage.complete && reviveImage.naturalWidth) {
        ctx.drawImage(reviveImage, revive.x, revive.y, revive.w, revive.h);
      }
      ctx.save();
      ctx.font = "bold 11px Menlo, Consolas, monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillStyle = "#ffffff";
      ctx.shadowColor = "#09091c";
      ctx.shadowBlur = 4;
      ctx.fillText(`x${this.game.shopInventory.revive}`, revive.x + revive.w / 2, revive.y + revive.h + 9);
      ctx.restore();
    }

    if (this.restartButtonImage.complete && this.restartButtonImage.naturalWidth) {
      const button = PLAYER_RESTART_BUTTON_BOUNDS;
      ctx.drawImage(this.restartButtonImage, button.x, button.y, button.w, button.h);
    }
  }

  private drawAngularPanel(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    width: number,
    height: number,
    cut: number,
    fill: string,
    stroke: string,
  ): void {
    ctx.save();
    ctx.fillStyle = fill;
    ctx.strokeStyle = stroke;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x + cut, y);
    ctx.lineTo(x + width - cut, y);
    ctx.lineTo(x + width, y + cut);
    ctx.lineTo(x + width, y + height - cut);
    ctx.lineTo(x + width - cut, y + height);
    ctx.lineTo(x + cut, y + height);
    ctx.lineTo(x, y + height - cut);
    ctx.lineTo(x, y + cut);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.restore();
  }

  private drawGeometricFrame(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    width: number,
    height: number,
    cut: number,
    color: string,
  ): void {
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x + cut, y);
    ctx.lineTo(x + width - cut, y);
    ctx.lineTo(x + width, y + cut);
    ctx.lineTo(x + width, y + height - cut);
    ctx.lineTo(x + width - cut, y + height);
    ctx.lineTo(x + cut, y + height);
    ctx.lineTo(x, y + height - cut);
    ctx.lineTo(x, y + cut);
    ctx.closePath();
    ctx.stroke();

    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x + 24, y + 1);
    ctx.lineTo(x + 64, y + 1);
    ctx.moveTo(x + width - 64, y + height - 1);
    ctx.lineTo(x + width - 24, y + height - 1);
    ctx.moveTo(x + 1, y + height - 68);
    ctx.lineTo(x + 1, y + height - 28);
    ctx.moveTo(x + width - 1, y + 28);
    ctx.lineTo(x + width - 1, y + 68);
    ctx.stroke();
    ctx.restore();
  }

  private drawHud(ctx: CanvasRenderingContext2D, stats: FrameStats): void {
    const g = this.game;
    const cfg = g.cfg;
    const p = g.player;

    const next = g.obstacles.find((o) => o.worldX - g.camera.x + o.width > cfg.playerScreenX);
    const nextDist = next ? next.distanceToPlayer(g.camera.x, cfg.playerScreenX, cfg.playerWidth) : NaN;
    const nextT = next ? next.timeToPlayer(g.camera.x, cfg.playerScreenX, cfg.playerWidth, g.worldSpeed) : NaN;
    const spawnIn = g.spawner.nextSpawnIn(g.camera.x);

    const lines: Array<[string, string]> = [
      [`FPS ${stats.fps.toFixed(1)}`, `frame ${(stats.frameDt * 1000).toFixed(1)}ms  fixed ${(cfg.fixedDt * 1000).toFixed(1)}ms (${(1 / cfg.fixedDt).toFixed(0)}Hz)`],
      [`state ${g.state}`, `player ${p.state}  steps ${g.stepCount}`],
      [`input ${g.input.isDown ? "HELD" : "released"}`, `held ${g.input.downDuration.toFixed(2)}s  since release ${g.input.upDuration.toFixed(2)}s`],
      [`pos (${cfg.playerScreenX.toFixed(0)}, ${p.y.toFixed(1)})`, `vy ${p.vy.toFixed(1)} px/s  ay ${p.ay.toFixed(0)} px/s^2`],
      [`world ${g.worldSpeed.toFixed(0)} px/s`, `distance ${g.camera.x.toFixed(0)} px  difficulty ${g.difficulty.toFixed(3)}`],
      [`seed ${cfg.seed}`, `obstacles ${g.obstacles.length}  next spawn in ${spawnIn.toFixed(0)}px (${g.worldSpeed > 0 ? (spawnIn / g.worldSpeed).toFixed(2) : "-"}s)`],
      [
        next ? `nearest #${next.id} ${next.type}` : "nearest: none",
        next ? `${nextDist.toFixed(0)}px -> ${isFinite(nextT) ? nextT.toFixed(2) : "inf"}s` : "",
      ],
    ];

    if (g.spawner.searchMode) {
      const s = g.spawner.scheduler;
      const a = s.active;
      const p = a?.progress;
      lines.push([
        `search ${a && p ? `E${a.ctx.encounterIndex} gen ${p.generation + 1}/${a.ctx.budget.generations} ${p.evaluated}/${p.total} ${p.elapsedMs.toFixed(0)}ms` : "idle"}`,
        `ready ${s.ready.length} · searched ${s.stats.searched} · sync ${s.stats.syncFinishes} · fallback ${s.stats.fallbacks} · ${s.strategy}`,
      ]);
      const playerWorldX = g.camera.x + cfg.playerScreenX;
      const current = s.committed.find((r) => playerWorldX >= r.startCameraX + cfg.playerScreenX && playerWorldX < r.endX);
      if (current) {
        const f = current.fitness;
        lines.push([
          `encounter E${current.index} ${current.phase}`,
          `target d ${current.target.difficulty.toFixed(2)} · ${current.candidateId} · ${current.phrase}` +
            (f ? ` · fit ${f.fitness.toFixed(2)} (dm ${f.difficultyMatch.toFixed(2)} rm ${f.rhythmMatch.toFixed(2)} nov ${f.novelty.toFixed(2)} rd ${f.readability.toFixed(2)})` : "") +
            (current.fallback ? ` · ${current.fallback}` : ""),
        ]);
      }
    }

    const boxW = 700;
    const boxH = lines.length * 15 + 12;
    ctx.fillStyle = COLORS.hudBg;
    ctx.fillRect(6, 6, boxW, boxH);

    lines.forEach(([a, b], i) => {
      this.text(ctx, a, 14, 22 + i * 15, COLORS.warn);
      this.text(ctx, b, 250, 22 + i * 15, COLORS.text);
    });

    const rejected = g.spawner.rejectedLog;
    if (rejected.length > 0) {
      this.text(ctx, `validator: ${rejected[rejected.length - 1]}`, 14, 22 + lines.length * 15, COLORS.danger);
    }

    this.text(
      ctx,
      "F1 overlay · F2 colliders · F3 vectors · F4 trajectory · F5 telemetry · F6 encounters · F7 grid · P pause · . step · R restart",
      6,
      CANVAS_HEIGHT - (g.debug.telemetry ? 132 : 0) - 8,
      COLORS.textDim,
    );
  }

  private drawStateOverlays(ctx: CanvasRenderingContext2D): void {
    const g = this.game;

    if (g.state === GameState.DEAD && g.deathInfo) {
      const d = g.deathInfo;
      // keep the collision source visible under the death report
      const killer = g.obstacles.find((o) => o.id === d.obstacleId);
      if (killer) {
        ctx.strokeStyle = COLORS.danger;
        ctx.lineWidth = 3;
        for (const r of killer.getRects(g.camera.x, g.time)) {
          ctx.strokeRect(r.x - 2, r.y - 2, r.w + 4, r.h + 4);
        }
      }

      const rows: Array<[string, string]> = [
        ["vy at impact", `${d.playerVy.toFixed(1)} px/s`],
        ["world speed", `${d.worldSpeed.toFixed(0)} px/s`],
        ["distance", `${d.distance.toFixed(0)} px`],
        ["difficulty", d.difficulty.toFixed(3)],
        ["reaction window at spawn", `${d.spawnReactionTime.toFixed(2)} s`],
      ];
      if (d.encounter) {
        // seed + encounter index + config reproduce this exact encounter; the candidate id names the genome
        rows.push(["encounter", `E${d.encounter.index} ${d.encounter.phase} · target d ${d.encounter.targetDifficulty.toFixed(2)}`]);
        rows.push(["candidate", `${d.encounter.candidateId}${d.encounter.fitness !== null ? ` · fit ${d.encounter.fitness.toFixed(3)}` : ""}`]);
        if (d.encounter.fallback) rows.push(["fallback", d.encounter.fallback]);
        rows.push(["reproduce", `seed ${g.cfg.seed} · encounter ${d.encounter.index} · same config + budget`]);
      }
      rows.push(["restart", "R = same seed · panel = new seed"]);

      const w = 560;
      const h = 42 + rows.length * 16;
      const x = (CANVAS_WIDTH - w) / 2;
      const y = 120;
      ctx.fillStyle = "rgba(20, 8, 10, 0.9)";
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = COLORS.danger;
      ctx.strokeRect(x, y, w, h);

      this.text(ctx, `DEAD — hit ${d.obstacleType} #${d.obstacleId}`, x + 14, y + 22, COLORS.danger);
      rows.forEach(([k, v], i) => {
        this.text(ctx, k, x + 14, y + 42 + i * 16, COLORS.textDim);
        this.text(ctx, v, x + 220, y + 42 + i * 16, COLORS.text);
      });
    } else if (g.state === GameState.READY) {
      const msg = "HOLD SPACE / CLICK to thrust — the run starts on first input";
      const w = 520;
      ctx.fillStyle = COLORS.hudBg;
      ctx.fillRect((CANVAS_WIDTH - w) / 2, 260, w, 34);
      this.text(ctx, msg, (CANVAS_WIDTH - w) / 2 + 14, 281, COLORS.warn);
    } else if (g.state === GameState.PAUSED) {
      this.text(ctx, "PAUSED — P resumes · . steps one fixed frame", CANVAS_WIDTH / 2 - 150, 40, COLORS.warn);
    }
  }

  private drawObstacleSprite(ctx: CanvasRenderingContext2D, obs: { id: number; type: ObstacleType; worldX: number; visualVariant?: string | null }, rects: Array<{ x: number; y: number; w: number; h: number }>): boolean {
    if (obs.visualVariant === "laserEmitter") {
      const sprite = this.laserEmitterImage;
      if (!sprite.complete || !sprite.naturalWidth || !rects.length) return false;
      const bounds = rects.reduce((union, rect) => ({
        x: Math.min(union.x, rect.x),
        y: Math.min(union.y, rect.y),
        right: Math.max(union.right, rect.x + rect.w),
        bottom: Math.max(union.bottom, rect.y + rect.h),
      }), {
        x: rects[0].x,
        y: rects[0].y,
        right: rects[0].x + rects[0].w,
        bottom: rects[0].y + rects[0].h,
      });
      ctx.drawImage(sprite, bounds.x, bounds.y, bounds.right - bounds.x, bounds.bottom - bounds.y);
      return true;
    }

    const variants = this.obstacleSprites[obs.type];
    const loaded = variants?.filter((image) => image.complete && image.naturalWidth) ?? [];
    if (!loaded.length || !rects.length) return false;

    const referenceRect = rects.reduce((largest, rect) => rect.h > largest.h ? rect : largest);
    const targetRatio = referenceRect.w / referenceRect.h;
    const compatible = loaded
      .map((image) => ({ image, difference: Math.abs(Math.log((image.naturalWidth / image.naturalHeight) / targetRatio)) }))
      .sort((a, b) => a.difference - b.difference)
      .slice(0, Math.min(4, loaded.length));
    const variantIndex = Math.abs(Math.floor(obs.worldX * 31 + obs.id * 17)) % compatible.length;
    const sprite = compatible[variantIndex].image;

    ctx.save();
    ctx.globalAlpha = obs.type === ObstacleType.GATE ? 0.94 : 1;
    for (const r of rects) {
      const scale = Math.max(r.w / sprite.naturalWidth, r.h / sprite.naturalHeight);
      const drawWidth = sprite.naturalWidth * scale;
      const drawHeight = sprite.naturalHeight * scale;
      ctx.save();
      ctx.beginPath();
      ctx.rect(r.x, r.y, r.w, r.h);
      ctx.clip();
      ctx.drawImage(
        sprite,
        0, 0, sprite.naturalWidth, sprite.naturalHeight,
        r.x + (r.w - drawWidth) / 2,
        r.y + (r.h - drawHeight) / 2,
        drawWidth,
        drawHeight,
      );
      ctx.restore();
    }
    ctx.restore();
    return true;
  }

  private text(ctx: CanvasRenderingContext2D, s: string, x: number, y: number, color: string): void {
    ctx.font = "11px Menlo, Consolas, monospace";
    ctx.fillStyle = color;
    ctx.textBaseline = "alphabetic";
    ctx.fillText(s, x, y);
  }

  private getPlayerFrame(time: number, thrusting: boolean, state: string): HTMLImageElement | null {
    if (!this.astronautFrames.length) return null;
    const frameRate = thrusting ? 14 : 8;
    const eased = Math.floor(time * frameRate) % this.astronautFrames.length;
    const frameIndex = state === "THRUSTING" ? eased : (Math.floor(time * frameRate * 0.7) + 1) % this.astronautFrames.length;
    return this.astronautFrames[frameIndex] ?? this.astronautFrames[0];
  }

  private polyline(ctx: CanvasRenderingContext2D, pts: Array<{ x: number; y: number }>, color: string, dash: number[]): void {
    if (pts.length < 2) return;
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.setLineDash(dash);
    ctx.beginPath();
    ctx.moveTo(pts[0].x, pts[0].y);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
    ctx.stroke();
    ctx.restore();
  }

  private arrow(
    ctx: CanvasRenderingContext2D,
    x0: number, y0: number, x1: number, y1: number,
    color: string, label: string,
  ): void {
    const dx = x1 - x0;
    const dy = y1 - y0;
    const len = Math.hypot(dx, dy);
    if (len < 2) return;

    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x1, y1);
    ctx.stroke();

    const ux = dx / len;
    const uy = dy / len;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x1 - ux * 7 - uy * 3.5, y1 - uy * 7 + ux * 3.5);
    ctx.lineTo(x1 - ux * 7 + uy * 3.5, y1 - uy * 7 - ux * 3.5);
    ctx.closePath();
    ctx.fill();

    this.text(ctx, label, x1 + 6, y1 - 4, color);
  }
}
