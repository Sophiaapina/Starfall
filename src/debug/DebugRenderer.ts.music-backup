import { ObstacleType } from "../game/Obstacle.js";
import { predictedHit, predictScreenPath } from "./TrajectoryPredictor.js";
import type { Telemetry } from "./Telemetry.js";

const COLORS = {
  gridMinor: "#1b1f27",
  gridMajor: "#252b36",
  gridLabel: "#3f4656",
  corridor: "#20242d",
  corridorEdge: "#3d4350",
  collider: "#4cc38a",
  obstacle: "#7a828f",
  obstacleMoving: "#8a7fb8",
  obstacleBad: "#e06c75",
  safeGap: "rgba(76, 195, 138, 0.14)",
  player: "#e8e8ec",
  flame: "#e5c07b",
  vel: "#4cc38a",
  thrust: "#e5c07b",
  gravity: "#e06c75",
  net: "#ffffff",
  trajHold: "#e5c07b",
  trajRelease: "#56b6c2",
  hudBg: "rgba(10, 12, 16, 0.78)",
  text: "#cfd3dc",
  textDim: "#8a90a0",
  warn: "#e5c07b",
  danger: "#e06c75",
  encounter: "#9aa5b8",
  witness: "#e5c07b",
  strongPath: "#56b6c2",
  intermediatePath: "#c678dd",
  novicePath: "#e0a06c",
  entry: "#4cc38a",
};

export interface FrameStats {
  fps: number;
  frameDt: number; // real time for this rendered frame
}

